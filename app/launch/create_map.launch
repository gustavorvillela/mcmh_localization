<launch>
  <!-- Argumentos -->
  <arg name="world" default="stage_bin"/>
  <arg name="model" default="waffle"/>

  <!-- Gazebo com mapa e TurtleBot -->
  <include file="$(find turtlebot3_gazebo)/launch/turtlebot3_$(arg world).launch">
    <arg name="model" value="$(arg model)"/>
  </include>
  <include file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch" />
  <include file="$(find turtlebot3_teleop)/launch/turtlebot3_teleop_key.launch" />

  <!-- SLAM -->
  <include file="$(find turtlebot3_slam)/launch/turtlebot3_gmapping.launch">
  </include>

  <!-- RViz -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find mcmh_localization)/rviz/mapping.rviz" />

</launch>